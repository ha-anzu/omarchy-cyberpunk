#!/bin/bash
# Toggle the Cyberpunk screen glitch. Off restores normal damage tracking.

flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/cp2077-glitch-off"
shader="$HOME/.config/hypr/shaders/cp2077.frag"
mkdir -p "$(dirname "$flag")"

if [[ -f $flag ]]; then
  rm -f "$flag"
  hyprctl eval "hl.config({ debug = { damage_tracking = 0 }, decoration = { screen_shader = '$shader' } })" >/dev/null
  hyprctl notify 5 1600 "rgb(fcee0a)" "Glitch on"
else
  touch "$flag"
  hyprctl eval 'hl.config({ decoration = { screen_shader = "" }, debug = { damage_tracking = 2 } })' >/dev/null
  hyprctl notify 1 1600 "rgb(fcee0a)" "Glitch off"
fi
