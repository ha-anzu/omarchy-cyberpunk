#!/usr/bin/env python3
# Netrunner breach. Omarchy runs this full screen in the idle terminal.
# The picture is a Cyberpunk interface: a real font, a chamfered frame,
# and a breach grid. Any key, or leaving the window, returns to the desktop.

import fcntl
import json
import os
import select
import signal
import struct
import subprocess
import sys
import termios
import time
import tty

SANS = "/usr/share/fonts/noto/NotoSans-Medium.ttf"
SANS_REG = "/usr/share/fonts/noto/NotoSans-Regular.ttf"
MONO = "/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf"
ENCODER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cp2077-sixel")

YELLOW = "#FCEE0A"
YELLOW_DIM = "#6E6412"
YELLOW_SOFT = "#C6B63A"
CYAN = "#00F0FF"
RED = "#FE1038"
INK = "#141200"
GRID_LINE = "#2A2608"

CODES = ("1C", "55", "7A", "BD", "E9", "FF")

# Orthogonal paths. The grid cells under a path show that daemon's sequence.
DAEMONS = (
    {
        "name": "SYNAPSE BURN",
        "seq": ("BD", "55", "E9", "1C"),
        "path": ((0, 0), (0, 1), (0, 2), (1, 2)),
        "cost": 4,
    },
    {
        "name": "WEAPON GLITCH",
        "seq": ("7A", "FF"),
        "path": ((2, 4), (2, 5)),
        "cost": 3,
    },
    {
        "name": "REBOOT OPTICS",
        "seq": ("E9", "1C", "BD"),
        "path": ((3, 1), (4, 1), (4, 2)),
        "cost": 5,
    },
    {
        "name": "SONIC SHOCK",
        "seq": ("55", "FF", "7A"),
        "path": ((4, 4), (4, 5), (3, 5)),
        "cost": 2,
    },
)

ROWS = 5
COLS = 6


def pixels():
    if os.environ.get("CP2077_SAVER_PNG"):
        return 1920, 1200
    try:
        packed = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, struct.pack("HHHH", 0, 0, 0, 0))
        _rows, _cols, xpix, ypix = struct.unpack("HHHH", packed)
        if xpix >= 640 and ypix >= 400:
            # Leave one text row so the sixel does not scroll the terminal.
            return xpix, max(400, ypix - 28)
    except OSError:
        pass
    return 1920, 1170


def grid_code(r, c):
    return CODES[(r * 5 + c * 3 + 2) % len(CODES)]


def build_grid():
    cells = [[grid_code(r, c) for c in range(COLS)] for r in range(ROWS)]
    for daemon in DAEMONS:
        for (r, c), code in zip(daemon["path"], daemon["seq"]):
            cells[r][c] = code
    return cells


GRID = build_grid()


class Draw:
    def __init__(self, width, height):
        self.width = width
        self.height = height
        self.s = min(width / 1920, height / 1200)
        self.args = [
            "magick",
            "-size",
            f"{width}x{height}",
            "xc:#000000",
            "-gravity",
            "NorthWest",
            "-depth",
            "8",
        ]

    def px(self, value):
        return max(1, int(round(value * self.s)))

    def fill(self, color):
        self.args.extend(["-fill", color, "-stroke", "none"])

    def pen(self, color, width):
        self.args.extend(["-fill", "none", "-stroke", color, "-strokewidth", str(self.px(width))])

    def font(self, path, size):
        self.args.extend(["-font", path, "-pointsize", str(self.px(size)), "-stroke", "none"])

    def text(self, x, y, message, color):
        self.fill(color)
        self.args.extend(["-annotate", f"+{int(x)}+{int(y)}", message])

    def rect(self, x0, y0, x1, y1, color):
        self.fill(color)
        self.args.extend(["-draw", f"rectangle {int(x0)},{int(y0)} {int(x1)},{int(y1)}"])

    def line(self, x0, y0, x1, y1, color, width):
        self.pen(color, width)
        self.args.extend(["-draw", f"line {int(x0)},{int(y0)} {int(x1)},{int(y1)}"])

    def poly(self, points, color, width):
        self.pen(color, width)
        body = " ".join(f"{int(x)},{int(y)}" for x, y in points)
        self.args.extend(["-draw", f"polyline {body}"])

    def run(self, sixel):
        if not sixel:
            proc = subprocess.run(self.args + ["png:-"], capture_output=True)
            if proc.returncode != 0:
                raise RuntimeError(proc.stderr.decode("utf-8", "replace")[:400])
            return proc.stdout
        proc = subprocess.run(self.args + ["rgb:-"], capture_output=True)
        if proc.returncode != 0 or len(proc.stdout) != self.width * self.height * 3:
            raise RuntimeError(proc.stderr.decode("utf-8", "replace")[:400] or "short frame")
        enc = subprocess.run(
            [ENCODER, str(self.width), str(self.height)],
            input=proc.stdout,
            capture_output=True,
        )
        if enc.returncode != 0 or not enc.stdout.startswith(b"\033P"):
            raise RuntimeError(enc.stderr.decode("utf-8", "replace")[:200] or "sixel encoder failed")
        return enc.stdout


def frame_path(d, x, y, w, h):
    # One chamfered rule. The bottom run leaves a single gap for the version.
    cut_a = d.px(34)
    cut_b = d.px(18)
    cut_c = d.px(22)
    cut_d = d.px(16)
    gap = d.px(70)
    mid = x + w // 2
    return [
        (x + cut_a, y),
        (x + w - cut_b, y),
        (x + w, y + cut_b),
        (x + w, y + h - cut_c),
        (x + w - cut_c, y + h),
        (mid + gap // 2, y + h),
    ], [
        (mid - gap // 2, y + h),
        (x + cut_d, y + h),
        (x, y + h - cut_d),
        (x, y + cut_a),
        (x + cut_a, y),
    ]


def render(width, height, tick, sixel=True):
    d = Draw(width, height)
    s = d.s
    daemon_i = (tick // 28) % len(DAEMONS)
    daemon = DAEMONS[daemon_i]
    step = tick % 28
    # Hold on the last cell, then move to the next daemon.
    cursor = min(step // 4, len(daemon["path"]) - 1)
    done = step >= 4 * len(daemon["path"]) + 6
    glitch = tick % 22 == 0

    margin = d.px(46)
    outer = frame_path(d, margin, d.px(28), width - margin * 2, height - d.px(56))
    d.poly(outer[0], YELLOW, 2)
    d.poly(outer[1], YELLOW, 2)
    # Cyan tick on the top-left chamfer, the same accent as the window frames.
    d.line(margin + d.px(8), d.px(78), margin + d.px(8), d.px(96), CYAN, 3)

    title_y = d.px(108)
    shift = d.px(10) if glitch else 0
    d.font(SANS, 42)
    d.text(d.px(86) + shift, title_y, "BREACH PROTOCOL", YELLOW)
    d.font(SANS_REG, 16)
    d.text(d.px(88), title_y + d.px(46), "NETWATCH    //    ACCESS POINT", YELLOW_DIM)

    trace = int(tick * 0.45)
    trace_color = RED if trace % 40 > 32 else CYAN
    d.font(MONO, 18)
    d.text(width - d.px(300), title_y - d.px(4), f"TRACE   {trace // 60:02d}:{trace % 60:02d}", trace_color)

    d.line(d.px(86), title_y + d.px(68), width - d.px(86), title_y + d.px(68), YELLOW, 1)

    # Sequences. Completed rows stay readable and quiet. The active row is the bright one.
    d.font(SANS, 15)
    d.text(d.px(88), d.px(196), "SEQUENCE", YELLOW)
    for i, item in enumerate(DAEMONS):
        y = d.px(250) + i * d.px(78)
        active = i == daemon_i and not done
        finished = i < daemon_i or (i == daemon_i and done)
        if active:
            d.rect(d.px(84), y - d.px(28), d.px(520), y + d.px(18), "#120F00")
            d.rect(d.px(84), y - d.px(28), d.px(88), y + d.px(18), CYAN)
        name_color = YELLOW if active else (YELLOW_SOFT if finished else YELLOW_DIM)
        d.font(MONO, 16)
        d.text(d.px(104), y, "  ".join(item["seq"]), name_color if active else YELLOW_DIM)
        d.font(SANS, 20)
        d.text(d.px(104), y + d.px(28), item["name"], name_color)
        if finished:
            d.line(d.px(430), y - d.px(6), d.px(490), y - d.px(6), CYAN, 2)

    # Breach grid.
    gx = d.px(600)
    gy = d.px(230)
    cw = d.px(148)
    ch = max(d.px(90), (height - d.px(170) - gy) // ROWS)
    lit = set(daemon["path"][: cursor + (0 if done else 1)])
    current = None if done else daemon["path"][cursor]
    for r in range(ROWS):
        for c in range(COLS):
            x = gx + c * cw
            y = gy + r * ch
            code = GRID[r][c]
            on_path = (r, c) in lit
            here = (r, c) == current
            if on_path:
                d.rect(x, y, x + cw - d.px(18), y + ch - d.px(24), "#141000")
            if here:
                d.line(x, y + ch - d.px(30), x + cw - d.px(18), y + ch - d.px(30), CYAN, 2)
            d.font(MONO, 32)
            color = YELLOW if on_path else YELLOW_DIM
            if here and (tick % 2 == 0):
                color = CYAN
            d.text(x + d.px(34), y + (ch // 2) + d.px(10), code, color)

    # Faint rails so the matrix reads as a board, not scattered type.
    for c in range(COLS + 1):
        x = gx + c * cw - d.px(10)
        d.line(x, gy - d.px(16), x, gy + ROWS * ch - d.px(20), GRID_LINE, 1)
    for r in range(ROWS + 1):
        y = gy + r * ch - d.px(16)
        d.line(gx - d.px(8), y, gx + COLS * cw - d.px(16), y, GRID_LINE, 1)

    # Buffer and ice, on the right. Short, and not a second picture.
    rx = gx + COLS * cw + d.px(36)
    d.font(SANS, 15)
    d.text(rx, d.px(196), "BUFFER", YELLOW)
    pips = 8
    filled = min(pips, daemon["cost"] + (0 if done else cursor))
    for i in range(pips):
        x = rx + (i % 4) * d.px(36)
        y = d.px(220) + (i // 4) * d.px(28)
        if i < filled:
            d.rect(x, y, x + d.px(24), y + d.px(14), YELLOW)
        else:
            d.line(x, y, x + d.px(24), y, YELLOW_DIM, 1)
            d.line(x, y + d.px(14), x + d.px(24), y + d.px(14), YELLOW_DIM, 1)
    d.font(MONO, 16)
    d.text(rx, d.px(300), f"RAM   {daemon['cost']:02d}", CYAN if not done else YELLOW_DIM)

    d.font(SANS, 15)
    d.text(rx, d.px(370), "ICE", YELLOW)
    d.font(SANS, 22)
    d.text(rx, d.px(408), "BLACKWALL", YELLOW_SOFT)
    d.font(MONO, 16)
    d.text(rx, d.px(440), "LAYER   03", YELLOW_DIM)
    d.font(SANS, 15)
    d.text(rx, d.px(510), "UPLINK", YELLOW)
    d.font(SANS, 22)
    d.text(rx, d.px(548), "NIGHT CITY", YELLOW_SOFT)
    d.font(MONO, 14)
    d.text(rx, d.px(584), "v.47", YELLOW_DIM)

    # Upload rule along the bottom.
    by = height - d.px(70)
    d.font(SANS, 16)
    label = "UPLOADED" if done else "UPLOADING"
    d.text(d.px(88), by - d.px(28), f"{label}    {daemon['name']}", CYAN if not done else YELLOW_SOFT)
    span = width - d.px(176)
    progress = 1.0 if done else (cursor + (0.5 if tick % 2 == 0 else 0.15)) / len(daemon["path"])
    progress = max(0.04, min(1.0, progress))
    d.line(d.px(88), by, d.px(88) + span, by, "#241F08", 4)
    d.line(d.px(88), by, d.px(88) + int(span * progress), by, YELLOW, 4)
    d.rect(
        d.px(88) + int(span * progress) - d.px(2),
        by - d.px(6),
        d.px(88) + int(span * progress) + d.px(2),
        by + d.px(6),
        CYAN,
    )

    if glitch:
        band = d.px(210) + (tick * 17 % (ROWS * 118)) * s
        d.line(d.px(70), band, width - d.px(70), band, CYAN, 2)

    return d.run(sixel)


def hypr_cursor(hidden):
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    flag = "true" if hidden else "false"
    subprocess.run(
        ["hyprctl", "eval", f"hl.config({{ cursor = {{ invisible = {flag} }} }})"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def screensaver_focused():
    try:
        out = subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True, timeout=1)
        return json.loads(out).get("class") == "org.omarchy.screensaver"
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return True


def main():
    png_path = os.environ.get("CP2077_SAVER_PNG")
    if png_path:
        width, height = pixels()
        tick = int(os.environ.get("CP2077_SAVER_TICK", "6"))
        data = render(width, height, tick, sixel=False)
        with open(png_path, "wb") as handle:
            handle.write(data)
        return

    once = os.environ.get("CP2077_SAVER_FRAMES")
    frames = int(once) if once else 0
    hypr_cursor(True)
    sys.stdout.buffer.write(b"\033]11;rgb:00/00/00\007\033[2J\033[H\033[?25l")
    sys.stdout.buffer.flush()
    fd = sys.stdin.fileno()
    old = None
    if sys.stdin.isatty() and frames == 0:
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)

    def finish(*_args):
        sys.stdout.buffer.write(b"\033[?25h\033[0m\033[2J\033[H")
        sys.stdout.buffer.flush()
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        hypr_cursor(False)
        raise SystemExit(0)

    signal.signal(signal.SIGINT, finish)
    signal.signal(signal.SIGTERM, finish)
    signal.signal(signal.SIGHUP, finish)
    width, height = pixels()
    started = time.monotonic()
    tick = 0
    try:
        while True:
            sys.stdout.buffer.write(b"\033[H" + render(width, height, tick, sixel=True))
            sys.stdout.buffer.flush()
            tick += 1
            if frames and tick >= frames:
                break
            if old is not None:
                ready, _, _ = select.select([fd], [], [], 0.02)
                if ready:
                    break
            else:
                time.sleep(0.02)
            if frames == 0 and time.monotonic() - started > 1.2 and tick % 4 == 0:
                if not screensaver_focused():
                    break
    finally:
        sys.stdout.buffer.write(b"\033[?25h\033[0m")
        sys.stdout.buffer.flush()
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        hypr_cursor(False)


if __name__ == "__main__":
    main()
